rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A minimal, UID-keyed lock prevents another signed-in device from
    // recreating progress while account deletion is in progress or complete.
    // The lock intentionally remains after Auth deletion; it contains no
    // artwork or contact data and prevents stale clients from resurrecting it.
    match /accountDeletionLocks/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow get: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(["deletionRequested"])
        && request.resource.data.deletionRequested == true;
      allow update: if isOwner()
        && resource.data.deletionRequested == true
        && request.resource.data.keys().hasOnly(["deletionRequested"])
        && request.resource.data.deletionRequested == true;
      allow delete: if false;
    }

    match /users/{userId}/mandalaProgress/{mandalaId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function accountIsNotDeleting() {
        return !exists(/databases/$(database)/documents/accountDeletionLocks/$(userId));
      }

      // Reads and deletes remain allowed so the owner can finish cleanup.
      // New progress writes are blocked as soon as the deletion lock exists.
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && accountIsNotDeleting();
    }
  }
}
